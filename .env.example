# --- Database (Postgres: Vercel Postgres / Neon / Supabase all work) ---
# Copy the connection string from your provider. Include ?sslmode=require for most hosts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Auth (NextAuth v5) ---
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# On Vercel this is set automatically; locally use http://localhost:3000
# AUTH_URL="http://localhost:3000"

# --- Claude API (used by the proposal drafting helper) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Seed admin (used by `npm run seed`) ---
SEED_ADMIN_EMAIL="gabriel@theabadigroup.com"
SEED_ADMIN_PASSWORD="changeme-on-first-login"

# --- Basecamp integration (register at launchpad.37signals.com/integrations) ---
# Redirect URL to register: https://tag-crm.vercel.app/api/basecamp/callback
BASECAMP_CLIENT_ID=""
BASECAMP_CLIENT_SECRET=""
# Optional — auto-detected on connect if omitted (your account is 5870399):
# BASECAMP_ACCOUNT_ID="5870399"
# BASECAMP_REDIRECT_URI="https://tag-crm.vercel.app/api/basecamp/callback"
# BASECAMP_USER_AGENT="TAG CRM (gabriel@theabadigroup.com)"

# --- Weekly follow-up email (Gmail / Google Workspace) ---
# Gmail address that sends the digest, and a Google App Password (needs 2-Step
# Verification on the account, then create one at myaccount.google.com/apppasswords).
GMAIL_USER="gabriel@theabadigroup.com"
GMAIL_APP_PASSWORD=""
# Who receives the weekly digest (defaults to julieta.chi@theabadigroup.com):
# FOLLOWUP_EMAIL_TO="julieta.chi@theabadigroup.com"
# Protects the cron endpoint — set the same value in Vercel; generate with: openssl rand -base64 32
CRON_SECRET=""
# Used to build links inside the email (defaults to https://tag-crm.vercel.app):
# APP_URL="https://tag-crm.vercel.app"
